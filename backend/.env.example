# backend/.env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ── Firebase Admin (backend) ─────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# Paste the full private key including -----BEGIN/END----- lines, with \n for newlines
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# ── Alpha Vantage (stock prices) ─────────────────────────
# Free: 25 req/day per key. Add up to 5 keys for 125 req/day.
ALPHA_VANTAGE_KEY_1=your_key_1
ALPHA_VANTAGE_KEY_2=your_key_2
ALPHA_VANTAGE_KEY_3=your_key_3
ALPHA_VANTAGE_KEY_4=your_key_4
ALPHA_VANTAGE_KEY_5=your_key_5
ALPHA_VANTAGE_KEY_6=your_key_6
ALPHA_VANTAGE_KEY_7=your_key_7

# ── Resend (transactional email) ─────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Without a custom domain use: onboarding@resend.dev (test only — delivers to verified inboxes)
RESEND_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Dhanalysis

# ── Perplexity AI ────────────────────────────────────────
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Demo account ─────────────────────────────────────────
# Firebase UID of the shared demo account (read-only for API write routes)
DEMO_USER_ID=your_demo_firebase_uid
